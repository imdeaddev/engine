#pragma once
#include <string_view>
#include <cstdint>

#define ENGINE_NAME_MACRO "${CMAKE_PROJECT_NAME}"
#define ENGINE_VERSION_MACRO "v${CMAKE_PROJECT_VERSION_MAJOR}.${CMAKE_PROJECT_VERSION_MINOR}.${CMAKE_PROJECT_VERSION_PATCH}"
#define ENGINE_VERSION_MAJOR_MACRO ${CMAKE_PROJECT_VERSION_MAJOR}
#define ENGINE_VERSION_MINOR_MACRO ${CMAKE_PROJECT_VERSION_MINOR}
#define ENGINE_VERSION_PATCH_MACRO ${CMAKE_PROJECT_VERSION_PATCH}

namespace engine {
constexpr std::string_view engineName = ENGINE_NAME_MACRO;
constexpr std::string_view engineVersionString = ENGINE_VERSION_MACRO;
constexpr uint32_t engineVersionMajor = ENGINE_VERSION_MAJOR_MACRO;
constexpr uint32_t engineVersionMinor = ENGINE_VERSION_MINOR_MACRO;
constexpr uint32_t engineVersionPatch = ENGINE_VERSION_PATCH_MACRO;
} // namespace engine
